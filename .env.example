# Copy to .env and fill in. Never commit the result.
#
# On the production server this file lives at the repository root, owned by the deploy user,
# mode 600. Nothing in it may ever be echoed into a log or passed as a command-line argument —
# `ps` is readable by every user on the machine.
#
# Generate each password with something that is not a keyboard pattern:
#   openssl rand -base64 36
IDENTITY_DB_PASSWORD=
# notification-service owns a second database on the same Postgres server.
NOTIFICATION_DB_PASSWORD=
REDIS_PASSWORD=
# First start only, minimum 12 characters. Unset after the bootstrap admin has
# changed its password. The username defaults to "admin".
BOOTSTRAP_ADMIN_PASSWORD=
# A single-line Ed25519 JWK. Produce one with either:
#   ./scripts/gen-signing-key.sh     (needs python3 + the cryptography package)
#   node scripts/gen-signing-key.mjs (needs Node 18+, no extra packages)
AUTH_SIGNING_KEY=
# The browser origins allowed to call this API. An explicit list, never a wildcard: a wildcard
# with credentials hands any site on the internet a session.
#
# In production the frontend and the API share one origin, so the browser sends no cross-origin
# request at all and this list is only reached by tools:
#   ALLOWED_ORIGINS=https://performance.drenix.uz
ALLOWED_ORIGINS=http://localhost:3005

# Swagger UI and the OpenAPI document. They publish every endpoint and the permission each one
# needs — a map of the attack surface. Leave true locally; the production compose overlay
# defaults it to false and the nginx site blocks the paths as well.
API_DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# External systems, per company. JM and BP are separate tenants of both:
# separate monday boards and separate RingCentral accounts. A company left
# empty simply cannot be reported on; everything else still works.
# ---------------------------------------------------------------------------
# One monday API token reads both boards today. Per-board overrides exist in
# performance-service configuration if that ever stops being true.
MONDAY_TOKEN=

# JM
MONDAY_BOARD_ID=
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=

# BP
MONDAY_BOARD_ID_BP=
RC_CLIENT_ID_BP=
RC_CLIENT_SECRET_BP=
RC_JWT_BP=

# The account used for anybody whose role grants name no company at all.
RC_DEFAULT_ENTITY=JM
# Dates, shift windows and hour labels. Must match across performance-service
# and notification-service, or a shift window judges hours nobody worked.
RC_ZONE=Asia/Tashkent

# performance-service keeps a daily snapshot of every shift in its own database.
PERFORMANCE_DB_PASSWORD=
# How many days back the snapshot backfills on a fresh deployment. Steady state is 2.
SNAPSHOT_DAYS=7

# Written feedback. Optional: without it that one endpoint answers 503 and nothing else changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
